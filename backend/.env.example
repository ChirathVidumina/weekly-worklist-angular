# MongoDB Atlas Configuration
# Replace <db_password> with your actual MongoDB Atlas database user password.
# Special characters in the password should be URL-encoded (e.g. '@' -> '%40', ':' -> '%3A')
MONGODB_PASSWORD=your_actual_password_here

